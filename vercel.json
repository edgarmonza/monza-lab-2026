{
  "buildCommand": "npm run build && node scripts/prerender.mjs",
  "rewrites": [
    {
      "source": "/monetizacion",
      "destination": "/monetizacion.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/work/spectro",
      "destination": "/work",
      "permanent": true
    },
    {
      "source": "/en/work/spectro",
      "destination": "/en/work",
      "permanent": true
    },
    {
      "source": "/de/work/spectro",
      "destination": "/de/work",
      "permanent": true
    },
    {
      "source": "/pt/work/spectro",
      "destination": "/pt/work",
      "permanent": true
    },
    {
      "source": "/monzastudio",
      "destination": "/shopify",
      "permanent": true
    },
    {
      "source": "/studio",
      "destination": "/shopify",
      "permanent": true
    },
    {
      "source": "/monzahaus",
      "destination": "/work/monza-haus",
      "permanent": true
    },
    {
      "source": "/monzaindex",
      "destination": "/work/ia-index",
      "permanent": true
    },
    {
      "source": "/bavarianecons",
      "destination": "/work/bavarian-econs",
      "permanent": true
    },
    {
      "source": "/agentes",
      "destination": "/plataformas",
      "permanent": true
    },
    {
      "source": "/en/monzastudio",
      "destination": "/en/shopify",
      "permanent": true
    },
    {
      "source": "/en/studio",
      "destination": "/en/shopify",
      "permanent": true
    },
    {
      "source": "/en/monzahaus",
      "destination": "/en/work/monza-haus",
      "permanent": true
    },
    {
      "source": "/en/monzaindex",
      "destination": "/en/work/ia-index",
      "permanent": true
    },
    {
      "source": "/en/bavarianecons",
      "destination": "/en/work/bavarian-econs",
      "permanent": true
    },
    {
      "source": "/en/agentes",
      "destination": "/en/plataformas",
      "permanent": true
    },
    {
      "source": "/de/monzastudio",
      "destination": "/de/shopify",
      "permanent": true
    },
    {
      "source": "/de/studio",
      "destination": "/de/shopify",
      "permanent": true
    },
    {
      "source": "/de/monzahaus",
      "destination": "/de/work/monza-haus",
      "permanent": true
    },
    {
      "source": "/de/monzaindex",
      "destination": "/de/work/ia-index",
      "permanent": true
    },
    {
      "source": "/de/bavarianecons",
      "destination": "/de/work/bavarian-econs",
      "permanent": true
    },
    {
      "source": "/de/agentes",
      "destination": "/de/plataformas",
      "permanent": true
    },
    {
      "source": "/pt/monzastudio",
      "destination": "/pt/shopify",
      "permanent": true
    },
    {
      "source": "/pt/studio",
      "destination": "/pt/shopify",
      "permanent": true
    },
    {
      "source": "/pt/monzahaus",
      "destination": "/pt/work/monza-haus",
      "permanent": true
    },
    {
      "source": "/pt/monzaindex",
      "destination": "/pt/work/ia-index",
      "permanent": true
    },
    {
      "source": "/pt/bavarianecons",
      "destination": "/pt/work/bavarian-econs",
      "permanent": true
    },
    {
      "source": "/pt/agentes",
      "destination": "/pt/plataformas",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "monza-lab-2026.vercel.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
