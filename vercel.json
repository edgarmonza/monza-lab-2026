{
  "buildCommand": "npm run build && node scripts/prerender.mjs",
  "rewrites": [
    {
      "source": "/monetizacion",
      "destination": "/monetizacion.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/work/spectro",
      "destination": "/work",
      "permanent": true
    },
    {
      "source": "/en/work/spectro",
      "destination": "/en/work",
      "permanent": true
    },
    {
      "source": "/de/work/spectro",
      "destination": "/de/work",
      "permanent": true
    },
    {
      "source": "/pt/work/spectro",
      "destination": "/pt/work",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "monza-lab-2026.vercel.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
